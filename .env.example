# URL base da API em produção
# (já definido em .env.production para deploy Vercel)
VITE_API_BASE_URL=https://api.lanzalocacoes.vercel.app

# ⚠️ Nunca coloque PGHOST, AWS_*, PGPASSWORD ou LANZA_JWT_SECRET neste repo.
# Essas variáveis pertencem ao projeto Vercel da API (lanza-locacoes-services).
# Ver lanza-locacoes-services/docs/vercel-env-api.md

# API key (quando LANZA_API_KEY está definida no servidor — legado/scripts)
# VITE_API_KEY=

# Em dev local, deixe VITE_API_BASE_URL vazio para usar o proxy do Vite
# VITE_API_PROXY_TARGET=http://127.0.0.1:3100

# Autenticação por utilizador (login/senha) — configure LANZA_JWT_SECRET no servidor API
# O token JWT fica guardado no localStorage do navegador após login/registo.
