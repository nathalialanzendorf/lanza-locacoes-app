# Apenas variáveis VITE_* — expostas no bundle do browser.
# NÃO coloque PGHOST, AWS_*, PGPASSWORD nem LANZA_JWT_SECRET aqui.
# Credenciais de RDS/AWS ficam no projeto Vercel da API (lanza-locacoes-services).
# Ver: lanza-locacoes-services/docs/vercel-env-api.md

VITE_API_BASE_URL=https://api.lanzalocacoes.vercel.app
